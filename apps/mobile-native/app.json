{
  "expo": {
    "name": "Prism Vault",
    "slug": "prism-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "network.prism.vault",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Prism reads verified health telemetry to generate zero-knowledge privacy proofs without transferring raw data.",
        "NSHealthUpdateUsageDescription": "Prism logs verified edge telemetry.",
        "NSFaceIDUsageDescription": "Use FaceID to authorize zero-knowledge dividend settlements."
      }
    },
    "android": {
      "package": "network.prism.vault",
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_SLEEP"
      ]
    }
  }
}
